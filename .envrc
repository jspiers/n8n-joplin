# Project secrets are encrypted in-repo (see .sops.yaml) and loaded into this
# shell only — never written to disk. Parsing is done by direnv's own dotenv
# parser, so quoting and comments behave normally.
#
# secrets/app.sops.env is the single source of truth: the S3 credentials it holds
# are Joplin's sync target, so the Joplin config is generated from them below
# rather than being a second encrypted copy of the same values.
if ! _sops_env="$(sops decrypt secrets/app.sops.env)"; then
  log_error "could not decrypt secrets/app.sops.env (missing ~/.config/sops/age/keys.txt?)"
  return 1
fi
eval "$("${direnv:-direnv}" dotenv bash <(printf '%s\n' "$_sops_env"))"
unset _sops_env

# joplin-config.base.json holds the non-secret settings; the secrets are merged
# in here. The result travels to the container base64-encoded (the image decodes
# it into tmpfs), so the plaintext is never a file on this machine or on the
# Docker daemon's host.
export JOPLIN_CONFIG_JSON_B64="$(
  jq -c \
    --arg url "${S3_SERVER:?S3_SERVER is unset}" \
    --arg path "${S3_PATH:?S3_PATH is unset}" \
    --arg user "${S3_KEY:?S3_KEY is unset}" \
    --arg pass "${S3_SECRET:?S3_SECRET is unset}" \
    --arg token "${JOPLIN_API_TOKEN:?JOPLIN_API_TOKEN is unset}" \
    '. * {
       "sync.8.url": $url,
       "sync.8.path": $path,
       "sync.8.username": $user,
       "sync.8.password": $pass,
       "api.token": $token
     }' joplin-config.base.json | base64 | tr -d '\n'
)"
