# Project secrets are encrypted in-repo (see .sops.yaml) and loaded into this
# shell only — never written to disk. Parsing is done by direnv's own dotenv
# parser, so quoting and comments behave normally.
if ! _sops_env="$(sops decrypt secrets/app.sops.env)"; then
  log_error "could not decrypt secrets/app.sops.env (missing ~/.config/sops/age/keys.txt?)"
  return 1
fi
eval "$("${direnv:-direnv}" dotenv bash <(printf '%s\n' "$_sops_env"))"
unset _sops_env
