# Project secrets are encrypted in-repo (see .sops.yaml) and loaded into this
# shell only — never written to disk. Parsing is done by direnv's own dotenv
# parser, so quoting and comments behave normally.
if ! _sops_env="$(sops decrypt secrets/app.sops.env)"; then
  log_error "could not decrypt secrets/app.sops.env (missing ~/.config/sops/age/keys.txt?)"
  return 1
fi
eval "$("${direnv:-direnv}" dotenv bash <(printf '%s\n' "$_sops_env"))"
unset _sops_env

# The Joplin profile config travels to the container base64-encoded (the image
# decodes it into tmpfs), so the plaintext is never a file on this machine or on
# the Docker daemon's host.
if ! _joplin_config="$(sops decrypt secrets/joplin.sops.json)"; then
  log_error "could not decrypt secrets/joplin.sops.json (missing ~/.config/sops/age/keys.txt?)"
  return 1
fi
export JOPLIN_CONFIG_JSON_B64="$(printf '%s' "$_joplin_config" | base64 | tr -d '\n')"
unset _joplin_config
